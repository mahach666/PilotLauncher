<Window x:Class="PilotLauncher.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Папка для версий Pilot" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75"
                   Text="Версии занимают сотни мегабайт каждая. Папка должна быть на локальном диске. Уже скачанные версии остаются на старом месте и в списке не появятся, пока вы не вернёте старую папку." />
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" VerticalContentAlignment="Center" Height="32" />
            <Button Grid.Column="1" Content="Выбрать..." Margin="8,0,0,0" Height="32" Click="Browse_Click" />
        </Grid>
        <TextBlock Text="Папка с установщиками" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75"
                   Text="Необязательно. Файлы Pilot-...-setup_версия.zip и .exe из этой папки при старте добавляются в список версий: их можно запустить без интернета. Папка может быть на флешке или в сети, файлы только читаются и не удаляются." />
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SetupBox" VerticalContentAlignment="Center" Height="32" />
            <Button Grid.Column="1" Content="Выбрать..." Margin="8,0,0,0" Height="32" Click="BrowseSetup_Click" />
        </Grid>
        <TextBlock Text="Предварительные версии" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
        <CheckBox x:Name="PrereleaseBox" Content="Показывать предварительные версии" Margin="0,8,0,0" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75"
                   Text="В списке версий появятся сборки из pilot.ascon.ru/beta, которых нет среди выпусков, с пометкой «бета». Заметки о выпуске тоже берутся оттуда." />
        <TextBlock Text="Обновления" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
        <CheckBox x:Name="CheckUpdatesBox" Content="Проверять обновления лаунчера при запуске" Margin="0,8,0,0" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75"
                   Text="Лаунчер спрашивает GitHub, вышла ли новая версия, и предлагает обновиться одной кнопкой. Скачанный файл сверяется с контрольной суммой релиза." />
        <TextBlock Text="Общие папки" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,0" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75"
                   Text="Версии, которые запускаются в отдельном профиле, работают под своим пользователем Windows и не видят ваши файлы. Чтобы открыть файл в такой версии Pilot, положите его в общую папку: папки из списка доступны им на чтение и изменение." />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="SharedList" Height="96" SelectionChanged="SharedList_SelectionChanged" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button Content="Добавить..." MinWidth="110" Click="AddShared_Click" />
                <Button x:Name="RemoveSharedButton" Content="Убрать" MinWidth="110" Margin="0,6,0,0" Click="RemoveShared_Click" IsEnabled="False" />
                <Button x:Name="OpenSharedButton" Content="Открыть" MinWidth="110" Margin="0,6,0,0" Click="OpenShared_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>
        <Button x:Name="CreateDefaultButton" Content="Создать папку по умолчанию" HorizontalAlignment="Left" Margin="0,10,0,0" Click="CreateDefaultShared_Click"
                ToolTip="Создаёт общую папку в «Общих документах» Windows. Права для неё не нужны, запрос Windows не появится." />
        <TextBlock x:Name="SharedHint" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.65" FontSize="12" />
        <TextBlock x:Name="ErrorText" Foreground="#E53935" Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" MinWidth="100" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
            <Button Content="Отмена" MinWidth="100" IsCancel="True" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
