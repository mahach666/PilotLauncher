<Window x:Class="PilotLauncher.App.IdentifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Какая это версия?" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Question" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"
                   Text="По имени и содержимому файла не удалось понять, какая это редакция и версия Pilot. Укажите их сами. Версию можно посмотреть в имени файла на сайте загрузки, например 26.9.0.61368." />
        <TextBlock Text="Редакция" FontSize="11" Opacity="0.65" Margin="2,16,0,2" />
        <ComboBox x:Name="EditionBox" DisplayMemberPath="DisplayName" />
        <TextBlock Text="Версия (четыре числа через точку)" FontSize="11" Opacity="0.65" Margin="2,12,0,2" />
        <TextBox x:Name="VersionBox" Height="32" VerticalContentAlignment="Center" />
        <TextBlock x:Name="ErrorText" Foreground="#E53935" Margin="0,8,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Добавить" MinWidth="100" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Пропустить" MinWidth="100" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
