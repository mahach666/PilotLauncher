<Window x:Class="PilotLauncher.App.InstallToSystemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка в систему" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Question" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Action" Margin="0,10,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="Details" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.8" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.65" FontSize="12"
                   Text="Сервер и другие редакции Pilot не затрагиваются. Версии, скачанные лаунчером, и их данные остаются на месте." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Установить в систему" MinWidth="160" Margin="0,0,8,0" Click="Install_Click" />
            <Button Content="Отмена" MinWidth="100" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
