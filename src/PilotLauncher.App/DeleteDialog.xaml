<Window x:Class="PilotLauncher.App.DeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление копии" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Question" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"
                   Text="Будет удалена копия, скачанная лаунчером. Установка Pilot в системе не затрагивается: её удаляет пункт «Удалить из системы»." />
        <CheckBox x:Name="DeleteDataBox" IsChecked="True" Margin="0,16,0,0">
            <TextBlock TextWrapping="Wrap"
                       Text="Удалить также данные этой версии: сохранённые подключения, логины и локальный кэш" />
        </CheckBox>
        <TextBlock Margin="28,4,0,0" TextWrapping="Wrap" Opacity="0.65" FontSize="12"
                   Text="Вместе с ними будет удалён временный пользователь Windows, созданный для этой версии. Может появиться запрос Windows." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Удалить" MinWidth="100" Margin="0,0,8,0" IsDefault="True" Click="Delete_Click" />
            <Button Content="Отмена" MinWidth="100" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
